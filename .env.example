# Admin login used the first time the site starts on Vercel
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=change-me
# Long random string used to sign admin login cookies
SESSION_SECRET=replace-with-a-long-random-string

# Public site address: used for canonical tags, sitemap.xml, robots.txt, Open Graph, JSON-LD and email links
SITE_URL=https://yourdomain.com

# Database: Supabase (run supabase/schema.sql once in the Supabase SQL editor)
SUPABASE_URL=https://your-project.supabase.co
# Supabase → Project Settings → API keys → service_role / secret key. Server-only, never share it.
SUPABASE_SERVICE_ROLE_KEY=

# Image uploads from the admin on Vercel (added automatically when you connect Vercel Blob)
# BLOB_READ_WRITE_TOKEN=

# Enquiry emails. Create a free key at https://resend.com and verify your domain.
# Without these the form still saves enquiries to the admin panel, but no email is sent.
RESEND_API_KEY=
EMAIL_FROM=Khushii Labs <hello@yourdomain.com>
# EMAIL_TO=you@gmail.com          # where "new enquiry" alerts go (defaults to the email in Settings)

# Google Analytics 4 measurement ID (analytics loads only when set)
NEXT_PUBLIC_GA_ID=
# Google Search Console → HTML tag method → the content="..." value
GOOGLE_SITE_VERIFICATION=

# Admin login used the first time the site starts on Vercel
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=change-me
# Long random string used to sign admin login cookies
SESSION_SECRET=replace-with-a-long-random-string

# Added automatically when you connect storage in the Vercel dashboard:
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN  (or KV_REST_API_URL / KV_REST_API_TOKEN)
# BLOB_READ_WRITE_TOKEN

# Enquiry emails (optional). Create a free key at https://resend.com and verify your domain.
# RESEND_API_KEY=re_...
# EMAIL_FROM=LazyDev <hello@yourdomain.com>
# EMAIL_TO=you@gmail.com          # where "new enquiry" alerts go (defaults to the email in Settings)
# SITE_URL=https://yourdomain.com # used for the logo and links inside emails
